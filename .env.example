# Copy this file to .env on the server and replace every CHANGE_ME value.
SECRET_KEY=secretkey

DB_NAME=name_db
DB_USER=user
DB_PASSWORD=pass

# Server IP or domain, without http:// and without a path.
ALLOWED_HOSTS=192.168.100.221

# For HTTP by IP, leave these values as shown.
CSRF_TRUSTED_ORIGINS=http://192.168.100.221
CORS_ALLOWED_ORIGINS=http://192.168.100.221
HTTP_PORT=80
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# Microsoft Graph (dejar vacías hasta habilitar la integración).
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_MAILBOX=
